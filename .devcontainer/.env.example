# DartWing Flutter DevContainer Configuration
# Copy this file to .env and adjust values as needed
# This file is auto-copied on first container create via postCreateCommand

# User configuration (should match host user)
USER=brett
UID=1000
GID=1000

# Container naming
COMPOSE_PROJECT_NAME=dartwing-flutter

# Port mappings (host ports - adjust to avoid conflicts with other containers)
FLUTTER_WEB_PORT=3000
WEB_PORT=8080
ADB_PORT=5037

# Resource limits
CONTAINER_MEMORY=4g
CONTAINER_CPUS=2
